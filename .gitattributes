# Normalize line endings to LF for all text files in the repo
* text=auto eol=lf

# Force LF for JS/JSX/CSS/JSON regardless of OS
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Binary files — never convert
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
